{
  "name": "algoladder",
  "version": "1.0.0",
  "private": true,
  "description": "AlgoLadder — a structured 474-problem DSA preparation roadmap with progress tracking, spaced revision and analytics.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate-problems && next build",
    "build:only": "next build",
    "start": "next start",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "validate-problems": "node scripts/validate-problems.mjs",
    "dataset:build": "node scripts/build-dataset.mjs",
    "dataset:check-urls": "node scripts/check-urls.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/migrate.mjs --reset && node scripts/seed.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:all": "npm run validate-problems && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@monaco-editor/react": "^4.7.0",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "next": "^15.5.25",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^18.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
