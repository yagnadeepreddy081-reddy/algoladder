# ---------------------------------------------------------------------------
# AlgoLadder — environment variables
# Copy this file to `.env.local` and fill in real values.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Any Postgres 14+ connection string works. Options:
#   Supabase  -> Project Settings > Database > Connection string > URI
#   Neon      -> Dashboard > Connection Details
#   Local     -> postgres://postgres:postgres@localhost:5432/algoladder
DATABASE_URL=postgres://postgres:postgres@localhost:5432/algoladder

# Set to "require" for hosted Postgres (Supabase / Neon), "disable" for local.
PGSSLMODE=disable

# --- Auth (required) -------------------------------------------------------
# Secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-me-with-a-long-random-string

# How long a login session lasts, in days.
AUTH_SESSION_DAYS=30

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=AlgoLadder
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (optional) ------------------------------------------------------
# When false, password-reset links are printed to the server console instead of
# being emailed. Leave false for local development.
EMAIL_ENABLED=false
EMAIL_FROM=no-reply@example.com
# SMTP_URL=smtp://user:pass@smtp.example.com:587

# --- Premium / subscriptions ----------------------------------------------
# MOCK mode lets you grant yourself a plan from the Upgrade page with no
# payment provider involved. Use this for local development and testing.
MOCK_SUBSCRIPTIONS=true
NEXT_PUBLIC_MOCK_SUBSCRIPTIONS=true

# Length of the self-serve trial, in days.
TRIAL_DAYS=7

# Real payments are OFF unless you explicitly turn them on AND supply keys.
# Nothing in this project charges a card while PAYMENTS_ENABLED is false.
PAYMENTS_ENABLED=false
# PAYMENT_PROVIDER=razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Admin bootstrap -------------------------------------------------------
# Accounts registered with these e-mails are given the `admin` role on signup.
# Comma-separated. Leave empty and use `npm run admin:create` instead.
ADMIN_EMAILS=

# --- Seeding ---------------------------------------------------------------
# Marks every problem in these topics as premium when seeding. Comma-separated
# topic slugs. Everything else stays free.
PREMIUM_TOPIC_SLUGS=dynamic-programming,advanced-dsa
